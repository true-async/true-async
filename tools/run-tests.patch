--- a/run-tests.php
+++ b/run-tests.php
@@ -210,6 +210,16 @@
         $environment = getenv();
     }
 
+    /* true_async runner: $_ENV and getenv() rename or drop variables whose names are not PHP-safe,
+     * and Mull switches a mutant on by such a name; the process environment has them verbatim. */
+    if (is_readable('/proc/self/environ')) {
+        $environment = [];
+        foreach (explode("\0", rtrim(file_get_contents('/proc/self/environ'), "\0")) as $pair) {
+            [$name, $value] = explode('=', $pair, 2) + [1 => ''];
+            $environment[$name] = $value;
+        }
+    }
+
     if (empty($environment['TEMP'])) {
         $environment['TEMP'] = sys_get_temp_dir();
 
@@ -1316,6 +1326,12 @@
         $command = 'start "" /b /wait ' . $command . ' & exit';
     }
 
+    /* true_async runner: /bin/sh is dash on Debian and Ubuntu, and dash drops environment variables
+     * whose names are not shell identifiers; Mull switches a mutant on by such a name. */
+    if (!IS_WINDOWS && is_string($command) && is_executable('/bin/bash')) {
+        $command = ['/bin/bash', '-c', $command];
+    }
+
     $data = '';
 
     $bin_env = [];
@@ -1372,6 +1388,12 @@
         if ($n === 0) {
             /* timed out */
             $data .= "\n ** ERROR: process timed out **\n";
+            /* true_async runner: on Windows $proc is the cmd.exe of `start /b /wait`, and terminating
+             * it leaves the test's php.exe running; that one keeps the test's files open, so a retry
+             * cannot write them. */
+            if (IS_WINDOWS) {
+                exec('taskkill /F /T /PID ' . proc_get_status($proc)['pid'] . ' > NUL 2>&1');
+            }
             proc_terminate($proc, 9);
             return $data;
         }
@@ -1395,7 +1417,7 @@
     $stat = proc_get_status($proc);
 
     if ($stat['signaled']) {
-        $data .= "\nTermsig=" . $stat['stopsig'] . "\n";
+        $data .= "\nTermsig=" . $stat['termsig'] . "\n";
     }
     if ($stat["exitcode"] > 128 && $stat["exitcode"] < 160) {
         $data .= "\nTermsig=" . ($stat["exitcode"] - 128) . "\n";
@@ -2885,7 +2907,21 @@
 
         $wanted_re = null;
     }
+    /* true_async runner: a test the timeout or a signal killed, or with a sanitizer or leak report,
+     * never passes, even when a trailing %A takes whatever output it left; such a pass would also
+     * lift the XFAIL of a step still to come. */
+    if ($passed && (str_contains($output, '** ERROR: process timed out **')
+            || preg_match('/^Termsig=\d+$/m', $output) || str_contains($output, 'ERROR: AddressSanitizer')
+            || str_contains($output, 'ERROR: LeakSanitizer') || str_contains($output, 'runtime error:')
+            || str_contains($output, 'memory leaks detected ==='))) {
+        $passed = false;
+    }
+
     if (!$passed && !$retried && error_may_be_retried($test, $output)) {
+        /* true_async runner: a retry discards the first attempt, and a test that passes on it
+         * would leave only a WARN behind. */
+        echo "RETRY $shortname: the first attempt failed\n",
+            generate_diff($wanted, $wanted_re, $output), "\n";
         $retried = true;
         goto retry;
     }
